      "source": [
        "# network\n",
        "\n",
        "#       o  flower type\n",
        "#      / \\  w1, w2, b\n",
        "#     o   o  length, width"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 19,
      "metadata": {
        "collapsed": true,
        "id": "iHY0iXGS8XZ3"
      },
      "outputs": [],
      "source": [
        "# activation function\n",
        "\n",
        "def sigmoid(x):\n",
        "    return 1/(1+np.exp(-x))\n",
        "\n",
        "def sigmoid_p(x):\n",
        "    return sigmoid(x) * (1-sigmoid(x))"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 20,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
