      "source": [
        "# each point is length, width, type (0, 1)\n",
        "\n",
        "data = [[3,   1.5, 1],\n",
        "        [2,   1,   0],\n",
        "        [4,   1.5, 1],\n",
        "        [3,   1,   0],\n",
