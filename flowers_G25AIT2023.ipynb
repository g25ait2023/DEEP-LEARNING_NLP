          },
          "metadata": {}
        }
      ],
      "source": [
        "X = np.linspace(-5, 5, 100)\n",
        "\n",
        "plt.plot(X, sigmoid(X), c=\"b\") # sigmoid in blue\n",
        "fig = plt.plot(X, sigmoid_p(X), c=\"r\") # sigmoid_p in red"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 30,
      "metadata": {
